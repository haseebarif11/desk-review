# Copy to .env and fill in your values
ANTHROPIC_API_KEY=your_api_key_here

# Optional overrides
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_MAX_TOKENS=2048
# API_TIMEOUT_SECONDS=60
# API_MAX_RETRIES=3
# API_RETRY_BASE_DELAY_SECONDS=1.0
# RATE_LIMIT_DEFAULT=10 per minute          # local dev
# RATE_LIMIT_DEFAULT=3 per minute           # recommended for a public HF Space
# MAX_RESUME_LENGTH=15000
# MIN_RESUME_LENGTH=50
# MAX_TARGET_ROLE_LENGTH=200
# MAX_JOB_DESCRIPTION_LENGTH=5000
# FLASK_SECRET_KEY=change-me-in-production
# CORS_ORIGINS=https://your-frontend.example.com
# LOG_LEVEL=INFO
